NH_STR(NH_STR_INTRO_CHOICE_SKIP, "Je me débrouille", "I'll manage")
NH_STR(NH_STR_INTRO_CHOICE_PROMPT, "Votre choix (Entrée = 1) : ", "Your choice (Enter = 1): ")
NH_STR(NH_STR_INTRO_ECHO_TUTORIAL,
       "Bonne décision. Reste concentré et fais exactement ce que je te dis.",
       "Good call. Stay focused and do exactly what I tell you.")
NH_STR(NH_STR_INTRO_ECHO_SKIP,
       "Comme tu veux. Ne viens pas pleurer quand l'alerte grimpera.",
       "Suit yourself. Don't come crying when your alert level climbs.")

/* ---- Tutoriel : la mission « Premiers pas » (src/game/tutorial.c) ---- */
NH_STR(NH_STR_TUT_MISSION_TITLE, "Premiers Pas dans l'Ombre", "First Steps in the Shadows")
NH_STR(NH_STR_TUT_LOG_TITLE, "=== MISSION EN COURS ===", "=== CURRENT MISSION ===")
NH_STR(NH_STR_TUT_LOG_CONTACT, "Contact", "Contact")
NH_STR(NH_STR_TUT_LOG_REWARD, "Récompense : %d ¢ et %d de réputation", "Reward: %d ¢ and %d reputation")
NH_STR(NH_STR_TUT_STEP_DONE, "✔ Objectif accompli : %s", "✔ Objective complete: %s")
NH_STR(NH_STR_TUT_REMINDER, "Concentre-toi, rookie. Ton objectif : %s", "Focus, rookie. Your objective: %s")
NH_STR(NH_STR_TUT_RESUME,
       "Content de te revoir, %s. On reprend là où on s'était arrêtés.",
       "Good to see you again, %s. Let's pick up where we left off.")
NH_STR(NH_STR_TUT_DONE_1,
       "Pas mal du tout, %s. Tu tiens debout, et le réseau ne t'a pas encore avalé.",
       "Not bad at all, %s. You're still standing, and the net hasn't swallowed you yet.")
NH_STR(NH_STR_TUT_DONE_2,
       "Voilà pour ton premier boulot. Continue à scanner : de nouveaux systèmes apparaîtront à mesure que tu montes en niveau.",
       "That's for your first job. Keep scanning: new systems will show up as you level up.")
NH_STR(NH_STR_TUT_DONE_3,
       "Et méfie-toi de Nexus Corp. Ils préparent quelque chose de gros...",
       "And watch out for Nexus Corp. They're planning something big...")

NH_STR(NH_STR_TUT_OBJ_QUESTS, "Ouvrir le journal de mission (quests)", "Open the mission log (quests)")
NH_STR(NH_STR_TUT_OBJ_HELP, "Consulter l'aide (help)", "Check the help (help)")
NH_STR(NH_STR_TUT_OBJ_SCAN, "Scanner le réseau (scan)", "Scan the network (scan)")
NH_STR(NH_STR_TUT_OBJ_STATUS, "Consulter votre fiche (status)", "Check your sheet (status)")
NH_STR(NH_STR_TUT_OBJ_LEVELUP, "Atteindre le niveau 2 (scan)", "Reach level 2 (scan)")
NH_STR(NH_STR_TUT_OBJ_BRUTEFORCE, "Pirater votre poste (bruteforce localhost)", "Hack your own machine (bruteforce localhost)")
NH_STR(NH_STR_TUT_OBJ_LAYLOW, "Faire baisser l'alerte (laylow)", "Lower your alert (laylow)")

NH_STR(NH_STR_TUT_SAY_QUESTS,
       "Voici comment ça marche, rookie : tout se fait pas à pas. Tape 'quests' pour ouvrir ton journal de mission et voir ce qui t'attend.",
       "Here's how it works, rookie: everything happens step by step. Type 'quests' to open your mission log and see what lies ahead.")
NH_STR(NH_STR_TUT_SAY_HELP,
       "Bien. Maintenant, apprends ce que ton deck sait faire : tape 'help'. Seules les commandes que tu maîtrises y figurent, la liste s'allongera avec ton niveau.",
       "Good. Now learn what your deck can do: type 'help'. Only the commands you have mastered are listed, and the list grows as you level up.")
NH_STR(NH_STR_TUT_SAY_SCAN,
       "Un hacker observe avant d'agir. 'scan' cartographie les systèmes à ta portée. Lance-en un.",
       "A hacker looks before acting. 'scan' maps the systems within your reach. Run one.")
NH_STR(NH_STR_TUT_SAY_STATUS,
       "Chaque action laisse une trace : c'est l'ALERTE. Tape 'status' pour voir ta fiche : niveau, expérience, crédits et alerte. Si l'alerte atteint 100, la sécurité te retrouve et la partie est perdue.",
       "Every action leaves a trace: that's the ALERT. Type 'status' to see your sheet: level, experience, credits and alert. If the alert hits 100, security finds you and the game is lost.")
NH_STR(NH_STR_TUT_SAY_LEVELUP,
       "Un scan ne suffit pas à cartographier le réseau. Chaque nouveau scan t'apprend un peu moins que le précédent, mais te fait progresser. Refais 'scan' jusqu'au niveau 2 : de nouvelles commandes s'ouvriront à toi.",
       "One scan won't map the network. Each new scan teaches you a little less than the last, but you still progress. Keep running 'scan' until level 2: new commands will open up.")
NH_STR(NH_STR_TUT_SAY_BRUTEFORCE,
       "Niveau 2 : 'bruteforce' est à toi. Entraîne-toi sur ton propre poste avec 'bruteforce localhost'. Ça peut échouer, alors réessaie : c'est le principe de la force brute, mais chaque échec fait grimper l'alerte.",
       "Level 2: 'bruteforce' is yours. Practice on your own machine with 'bruteforce localhost'. It can fail, so try again: that's how brute force works, but every failure raises your alert.")
NH_STR(NH_STR_TUT_SAY_LAYLOW,
       "Joli. Mais tu as laissé des traces. 'laylow' ouvre un menu pour faire redescendre l'alerte : choisis une méthode et applique-la (attendre est gratuit). Apprends à t'en servir avant d'en avoir besoin.",
       "Nice. But you left traces. 'laylow' opens a menu to bring your alert back down: pick a method and apply it (waiting is free). Learn it before you need it.")

