/*
 * Table des textes du jeu : NH_STR(CLÉ, "français", "english").
 *
 * Une seule ligne par texte, avec les deux langues côte à côte : impossible
 * d'oublier une traduction (le fichier ne compilerait pas), et un test vérifie
 * que les deux versions contiennent les mêmes marqueurs printf (%d, %s...).
 */
